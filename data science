# STEP 4: CREATE DATA PROCESSING FUNCTION

def process_file(file_path):

    start_time = time.time()

    print("\nProcessing:", os.path.basename(file_path))

    # Read CSV file
    df = pd.read_csv(file_path)

    # Original dataset information
    original_rows = len(df)
    original_columns = len(df.columns)

    # Count missing values
    missing_values = int(df.isnull().sum().sum())

    # Remove duplicate records
    duplicates = int(df.duplicated().sum())
    df = df.drop_duplicates()

    # Handle missing values
    for column in df.columns:

        if pd.api.types.is_numeric_dtype(df[column]):

            median_value = df[column].median()

            if pd.notna(median_value):
                df[column] = df[column].fillna(median_value)
            else:
                df[column] = df[column].fillna(0)

        else:

            mode_value = df[column].mode()

            if len(mode_value) > 0:
                df[column] = df[column].fillna(mode_value.iloc[0])
            else:
                df[column] = df[column].fillna("Unknown")

    # Select numeric columns
    numeric_data = df.select_dtypes(include=np.number)

    # Calculate statistical analysis
    statistics = {}

    for column in numeric_data.columns:

        statistics[column] = {
            "Mean": round(float(numeric_data[column].mean()), 2),
            "Median": round(float(numeric_data[column].median()), 2),
            "Minimum": round(float(numeric_data[column].min()), 2),
            "Maximum": round(float(numeric_data[column].max()), 2),
            "Standard Deviation": round(
                float(numeric_data[column].std()), 2
            )
        }

    # Calculate categorical analysis
    categories = {}

    for column in df.select_dtypes(include="object").columns:

        categories[column] = (
            df[column].value_counts().head(5).to_dict()
        )

    # Save cleaned file
    file_name = os.path.basename(file_path)

    output_path = os.path.join(
        "processed_files",
        "cleaned_" + file_name
    )

    df.to_csv(output_path, index=False)

    # Processing time
    processing_time = round(time.time() - start_time, 4)

    # Prepare result
    result = {
        "File Name": file_name,
        "Original Rows": original_rows,
        "Cleaned Rows": len(df),
        "Columns": original_columns,
        "Missing Values": missing_values,
        "Duplicates Removed": duplicates,
        "Processing Time": processing_time,
        "Statistics": statistics,
        "Categories": categories
    }

    print("Completed:", file_name)

    return df, result


# STEP 5: PARALLEL PROCESSING

print("\n" + "=" * 60)
