print("=" * 60)

file_paths = [
    os.path.join("input_files", file)
    for file in os.listdir("input_files")
    if file.endswith(".csv")
]

processed_results = []

start_parallel = time.time()

# Process multiple files simultaneously

with ThreadPoolExecutor(max_workers=3) as executor:

    results = list(executor.map(process_file, file_paths))

parallel_time = round(time.time() - start_parallel, 4)

# Separate cleaned DataFrames and reports

cleaned_dataframes = {}

for df, report in results:

    cleaned_dataframes[report["File Name"]] = df

    processed_results.append(report)

print("\nAll files processed successfully!")

print("Total files:", len(processed_results))
print("Total parallel processing time:", parallel_time, "seconds")


